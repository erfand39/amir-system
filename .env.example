# Copy to .env and use the database credentials from your hosting account.
NODE_ENV=production
APP_URL=https://YOUR-DOMAIN.example
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpuser_amirshop
DB_USER=cpuser_amirapp
DB_PASSWORD=REPLACE_WITH_DATABASE_USER_PASSWORD
DB_SSL_CA=
COOKIE_SECURE=true
SESSION_HOURS=24
SESSION_IDLE_MINUTES=60
AMIR_MAINTENANCE_CRON=false
SETUP_TOKEN=
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
